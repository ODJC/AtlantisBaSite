{
  "name": "@atlantis/file-share",
  "version": "0.1.5",
  "private": false,
  "description": "Reusable multi-client file sharing for Atlantis Next.js sites",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./brand": "./src/brand.tsx",
    "./schema": "./src/lib/db/schema.ts",
    "./db": "./src/lib/db/index.ts",
    "./session": "./src/lib/session.ts",
    "./api/upload": "./src/api/upload/route.ts",
    "./api/files": "./src/api/files/route.ts",
    "./api/files/[id]": "./src/api/files/[id]/route.ts",
    "./api/files/[id]/download": "./src/api/files/[id]/download/route.ts",
    "./api/files/download-all": "./src/api/files/download-all/route.ts",
    "./api/clients": "./src/api/clients/route.ts",
    "./api/clients/[id]": "./src/api/clients/[id]/route.ts",
    "./api/auth/admin": "./src/api/auth/admin/route.ts",
    "./api/auth/admin/logout": "./src/api/auth/admin/logout/route.ts",
    "./api/auth/client": "./src/api/auth/client/route.ts",
    "./api/auth/client/logout": "./src/api/auth/client/logout/route.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@vercel/blob": "^2.0.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.0.0",
    "drizzle-orm": "^0.45.0",
    "jose": "^6.0.0",
    "lucide-react": ">=0.400.0",
    "next": "^15.0.0 || ^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.0.0 || ^20.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19",
    "typescript": "^5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
