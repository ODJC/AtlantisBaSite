# Copy to .env.local and set your values
FIRMAS_PASSWORD=change-me
# Optional: separate signing secret (defaults to FIRMAS_PASSWORD)
# FIRMAS_AUTH_SECRET=random-long-string

# File share (Atlantis’s own database and Blob, not Savitar/OMA)
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
ADMIN_PASSWORD=change-me-admin-password
SESSION_SECRET=change-me-long-random-secret-at-least-32-chars
